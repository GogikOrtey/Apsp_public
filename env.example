# ============================================================================
# API-ключи для нейросетей
# ============================================================================

# API-ключ для YandexGPT (устаревший функционал)
# API_KEY=

# API-ключ от OpenAI, для запросов к ChatGPT (см. папку "ChatGPT")
# OPEN_AI_API_KEY=

# ============================================================================
# Настройки Telegram бота для APSP
# ============================================================================
# Скопируйте этот файл в .env и заполните своими значениями

# Токен бота от @BotFather (обязательно)
APSP_TELEGRAM_BOT_TOKEN=your_bot_token_here

# Username бота без @ (обязательно)
APSP_TELEGRAM_BOT_USERNAME=auto_gen_parsers_info_bot

# Секретная фраза для webhook (обязательно, придумайте свою)
APSP_TELEGRAM_WEBHOOK_SECRET=your_secret_webhook_key_here

# Базовый URL сервиса
# Для локальной разработки: http://127.0.0.1:5000
# Для ngrok: https://xxxx.ngrok-free.app
# Для продакшена: https://ваш-домен.com
APSP_BASE_URL=http://127.0.0.1:5000

# Диагностические чаты (опционально)
# ВАЖНО: это числовые chat_id, часто отрицательные для супергрупп/каналов (например -1001234567890)
# APSP_TELEGRAM_LOG_CHAT_ID=
# APSP_TELEGRAM_INFO_CHAT_ID=

# ============================================================================
# Дополнительные настройки (опционально)
# ============================================================================

# Хост и порт для Flask
# APSP_HOST=127.0.0.1
# APSP_PORT=5000
# APSP_DEBUG=true

# Максимальное количество параллельных задач
# APSP_MAX_WORKERS=10

# Таймаут выполнения задачи в секундах (по умолчанию 30 минут)
# APSP_TASK_TIMEOUT_SECONDS=1800

# Максимальное количество попыток при ошибке
# APSP_TASK_MAX_ATTEMPTS=1

# Но если всё это запускается в контейнере, .env там должен быть валидный и со всеми нужными значениями