        "болгарка",
        "сверло",
        "герметик"
    ],
    "search_input_selectors": [
        "input#qplSKIW",
        "form[action=\"/search/\"] input[name=\"q\"]",
        "div#custom-search-box input.search-suggest",
        "div.search_top input[name=\"q\"]",
        "input.search-suggest[name=\"q\"]"
    ],
