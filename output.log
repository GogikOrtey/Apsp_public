    "second_url": "https://makitatrading.ru/catalog/?q=%D0%B8%D0%BD%D1%81%D1%82%D1%80%D1%83%D0%BC%D0%B5%D0%BD%D1%82&s=%D0%9D%D0%B0%D0%B9%D1%82%D0%B8&PAGEN_2=2",
    "third_url": "https://makitatrading.ru/catalog/?q=%D0%B4%D1%80%D0%B5%D0%BB%D1%8C&s=%D0%9D%D0%B0%D0%B9%D1%82%D0%B8",
    "selector_product": ".catalog.catalogCards .itemCard[itemtype=\"http://schema.org/Product\"] > a.image[href^=\"/catalog/product/\"]",
    "additional_processing_for_the_link_value": true
}

