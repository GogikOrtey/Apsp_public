        "фитинг",
        "дымоход",
        "арматура"
    ],
    "search_input_selectors": [
        "form.c-input-search input[name=\"query\"]",
        "form[action=\"/search/\"] input[name=\"query\"]",
        "input.c-input-search__input[name=\"query\"]",
        ".c-header-bottom-bar__container-search input[name=\"query\"]",
        "input[placeholder=\"Поиск товаров\"]"
