                "name": "curl_command",
                "type": "str",
                "required": true,
                "description": "Полная команда curl одной строкой (можно с переносами строк и продолжением через \\)."
            },
            {
                "name": "trim_head_chars",
                "type": "int",
                "required": false,
                "description": "Сколько первых символов ответа показывать при обрезке (по умолчанию 300)."
            },
            {
