    "search_input_selectors": [
        "form.c-input-search input[name=\"query\"]",
        ".c-header-bottom-bar__container-search .c-input-search__input[name=\"query\"]",
        "input.c-input-search__input[name=\"query\"]"
    ],
    "search_button_selectors": [
        "form.c-input-search button.c-input-search__button",
        ".c-input-search__button-container > button.c-input-search__button",
        "form[action=\"/search/\"] button.c-input-search__button"
    ],
    "total_results_count_selectors": [
        ".c-search-page .c-block__header > h1.c-header_h1",
        ".c-search-page h1.c-header",
        ".l-content__content .c-search-page h1"
    ],
    "product_link_selectors": [
        ".c-search-page__products .c-products__list .c-product-thumb__name[href]",
        ".c-products__content .c-products-thumbs a.c-product-thumb__name[href]",
        ".c-products[data-products_count] a.c-product-thumb__name[href]"
