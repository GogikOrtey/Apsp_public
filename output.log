        ".c-breadcrumbs__item:nth-child(3) a"
    ],
    "brand": [
        ".c-product-cart-form__top-value .c-value__value-text a[href^=\"/brand/\"]",
        ".c-product-cart-form__top-value a[href^=\"/brand/\"]",
        ".c-product-cart-form__top-value .c-value__value-text a"
    ],
    "manufacturer": [
        ".c-product-features-overview__item .c-value__value-text",
        ".c-product-features-overview__item:first-child .c-value__value-text"
    ],
