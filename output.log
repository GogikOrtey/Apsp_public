                "description": "Лимит для all_results (по умолчанию 30)"
            },
            {
                "name": "print_cache_msgs",
                "type": "bool",
                "required": false,
                "description": "Печатать сообщения cache (по умолчанию False)"
            }
        ],
        "returns": {
