    "send_curl_request": {
        "name": "send_curl_request",
        "description": "Принимает описание HTTP-запроса в формате curl и выполняет запрос. Возвращает код ответа, заголовки, финальный URL (с учётом редиректов), историю редиректов и обрезанный текст ответа.",
        "args": [
