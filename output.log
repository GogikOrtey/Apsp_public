        "#breadcrumbs ul > li:nth-last-child(2) > a",
        "#breadcrumbs li:nth-last-child(2) a"
    ],
    "brand": [
        "#product_cloth_manuf span[itemprop=\"brand\"]",
        "#product_cloth_manuf [itemprop=\"brand\"]"
    ],
    "in_stock_trigger": [
