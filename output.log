        ],
        "returns": {
            "results": "list[dict]: [{link, used_selector, count_of_elements, main_result, all_results, html_frame_main_result}]"
        },
        "example_args": {
            "selector": ".price",
            "links": [
                "https://example.com/a",
                "https://example.com/b"
