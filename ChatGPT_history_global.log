        "content": "{\n  \"name\": \"h1.c-header.c-header_h1\",\n  \"price\": \".c-product-add-to-cart__price\",\n  \"oldprice\": \".c-product-add-to-cart__compare-price\",\n  \"imageLink\": \"meta[property=\\\"og:image\\\"]\",\n  \"brand\": \".c-product-cart-form__top-value .c-value__value-text a.c-link\",\n  \"volume\": null,\n  \"stock\": \".c-product-skus-stocks__sku-stock-available\",\n  \"in_stock_status\": null,\n  \"out_of_stock_status\": \"Предзаказ\"\n}",
